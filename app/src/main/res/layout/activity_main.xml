<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 카메라 프리뷰를 담는 컨테이너 (화면비율 전환 시 이 영역 크기가 바뀜) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <jp.co.cyberagent.android.gpuimage.GPUImageView
            android:id="@+id/gpuImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.filmcamera.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 지금 선택된 필터 이름 -->
    <TextView
        android:id="@+id/txtFilterName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#66000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 우측 상단 아이콘 묶음: 설정 / 갤러리 / 화면비율 / 카메라전환 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="#66000000"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="설정" />

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="#66000000"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="갤러리" />

        <Button
            android:id="@+id/btnAspectRatio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="#66000000"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="0dp"
            android:text="FULL" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#66000000"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="카메라 전환" />

    </LinearLayout>

    <!-- 밝기(EV) 조절 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#66000000"
        android:padding="6dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnCapture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEvMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="－"
            android:padding="0dp" />

        <TextView
            android:id="@+id/txtEv"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EV 0.0"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnEvPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="＋"
            android:padding="0dp" />

    </LinearLayout>

    <!-- 갤러리에서 불러와서 필터 적용하기 -->
    <ImageButton
        android:id="@+id/btnImportPhoto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="32dp"
        android:background="#66000000"
        android:src="@android:drawable/ic_menu_add"
        android:contentDescription="사진 불러오기"
        app:layout_constraintBottom_toBottomOf="@id/btnCapture"
        app:layout_constraintTop_toTopOf="@id/btnCapture"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 촬영 버튼 -->
    <ImageButton
        android:id="@+id/btnCapture"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="32dp"
        android:background="@android:drawable/presence_online"
        android:backgroundTint="@color/white"
        android:contentDescription="촬영"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 촬영 후 리뷰 화면 -->
    <FrameLayout
        android:id="@+id/reviewLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtReviewFilterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="#66000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="24dp">

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="다시 찍기" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="저장하기"
                android:backgroundTint="@color/accent" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
